                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": "watermark.json",
                        "folderPath": "config",
                        "fileSystem": "mobility"
                    },
                    "encodingName": "UTF-8"
                },
                "schema": {
                    "type": "object",
                    "properties": {
                        "last_processed_month": {
                            "type": "string"
                        },
                        "next_month": {
                            "type": "string"
                        },
