                                "referenceName": "ds_adls_bronze_tlc",
                                "type": "DatasetReference",
                                "parameters": {
                                    "p_year_month": {
                                        "value": "@pipeline().parameters.YearMonth",
                                        "type": "Expression"
                                    }
                                }
                            }
                        ]
                    }
                ],
                "policy": {
                    "elapsedTimeMetric": {}
                },
                "parameters": {
                    "YearMonth": {
                        "type": "string",
                        "defaultValue": "2024-01"
                    }
                },
                "annotations": [],
                "lastPublishTime": "2026-10-07T13:20:20Z"
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/datasets/ds_http_tlc_yellow_taxi')]",
                "[concat(variables('factoryId'), '/datasets/ds_adls_bronze_tlc')]"
            ]
        },
