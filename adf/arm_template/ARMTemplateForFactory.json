                        "inputs": [
                            {
                                "referenceName": "ds_http_tlc_yellow_taxi",
                                "type": "DatasetReference",
                                "parameters": {
                                    "p_year_month": {
                                        "value": "@pipeline().parameters.YearMonth",
                                        "type": "Expression"
                                    }
                                }
                            }
                        ],
                        "outputs": [
