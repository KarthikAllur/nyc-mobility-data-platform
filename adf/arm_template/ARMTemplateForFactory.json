                    "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": {
                            "value": "@concat('yellow_tripdata_', dataset().p_year_month, '.parquet')\n",
                            "type": "Expression"
                        },
                        "folderPath": "bronze/tlc",
                        "fileSystem": "mobility"
                    }
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_adls_nyc_mobility')]"
