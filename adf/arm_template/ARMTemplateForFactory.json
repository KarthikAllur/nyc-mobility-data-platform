                    },
                    {
                        "name": "Exec_Ingest_Weather",
                        "type": "ExecutePipeline",
                        "dependsOn": [],
                        "policy": {
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "pipeline": {
                                "referenceName": "pl_ingest_weather_bronze",
                                "type": "PipelineReference"
                            },
                            "waitOnCompletion": true,
                            "parameters": {
                                "YearMonth": {
                                    "value": "@pipeline().parameters.YearMonth",
