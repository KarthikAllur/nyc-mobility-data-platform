{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-nyc-mobility-dev"
        },
        "ls_adls_nyc_mobility_accountKey": {
            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'ls_adls_nyc_mobility'"
        },
        "ls_databricks_nyc_mobility_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'ls_databricks_nyc_mobility'"
        },
        "ls_adls_nyc_mobility_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://stnycmobilitydevka.dfs.core.windows.net/"
        },
        "ls_http_tlc_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://d37ci6vzurychx.cloudfront.net"
        },
        "ls_http_weather_api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://archive-api.open-meteo.com"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "[concat(parameters('factoryName'), '/tr_daily_backfill_twice_a_day')]",
            "type": "Microsoft.DataFactory/factories/triggers",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "runtimeState": "Started",
                "pipelines": [
                    {
                        "pipelineReference": {
                            "referenceName": "pl_master_end_to_end",
                            "type": "PipelineReference"
                        },
                        "parameters": {}
                    }
                ],
                "type": "ScheduleTrigger",
                "typeProperties": {
                    "recurrence": {
                        "frequency": "Hour",
                        "interval": 12,
                        "startTime": "2026-10-28T09:00:00",
                        "timeZone": "India Standard Time"
                    }
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/pipelines/pl_master_end_to_end')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ls_adls_nyc_mobility')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "type": "AzureBlobFS",
                "typeProperties": {
                    "url": "[parameters('ls_adls_nyc_mobility_properties_typeProperties_url')]",
